# Active network: "localhost" (hardhat) or "sepolia"
VITE_ACTIVE_NETWORK=localhost

# Contract addresses (update after deployment)
VITE_NFT57B_ADDRESS=0x0000000000000000000000000000000000000000
VITE_COMPANY_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_RECOGNITION_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# WalletConnect Project ID (optional, required for WalletConnect connector)
# Get one at https://cloud.walletconnect.com/
VITE_WALLETCONNECT_PROJECT_ID=

# Pinata IPFS API keys
VITE_PINATA_API_KEY=your_pinata_api_key
VITE_PINATA_SECRET_KEY=your_pinata_secret_key
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud

# App Metadata
VITE_APP_NAME=NFT57B - Employee Recognition
